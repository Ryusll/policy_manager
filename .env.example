# Copy to .env — Docker Compose reads this for ${PUBLIC_URL} substitution.
# Cloud: set PUBLIC_URL to the URL users type in the browser (https://your-domain.com).

PUBLIC_URL=http://localhost

# ─────────────────────────────────────────────────────────────
# 법제처 국가법령정보 공동활용 OPEN API (규정 가져오기)
#
# 신청·발급: https://open.law.go.kr → OPEN API 신청 (승인까지 영업일 소요)
# LAW_GO_KR_OC = 발급받은 "인증값". 보통 신청한 이메일의 아이디 부분이다(예: hong@x.com → hong).
#
# ★ 법제처는 인증값과 함께 호출한 서버의 IP·도메인을 검증해 거절할 수 있다.
#   운영에서 "사용자 정보 검증에 실패하였습니다"가 나오면 법제처에 등록된 서버 IP·도메인을 확인한다.
#   (2026-10-07 운영 서버는 로컬과 같은 인증값으로, IP를 따로 등록하지 않고도 통과했다.
#    "API인증키관리" 화면에는 IP 칸이 없다.)
#
# 비워두면 연동만 비활성화되고 나머지 기능은 그대로 동작한다(가져오기 화면에서 안내만 뜬다).
# ─────────────────────────────────────────────────────────────
LAW_GO_KR_OC=
# 법령 동기화(T-151) — 비우면 기본값. 두 확인 사이에 공포된 판을 공포 순으로 하나씩 반영한다
#   LAW_SYNC_MAX_VERSIONS = 법령당 한 번에 반영할 판 수(기본 5, 최대 50). 남은 판은 다음 동기화가 잇는다
#   LAW_SYNC_BUDGET_MS = 한 실행의 시간 상한(기본 1200000 = 20분). 넘으면 다음 법령·판을 시작하지 않는다
LAW_SYNC_MAX_VERSIONS=
LAW_SYNC_BUDGET_MS=

# ─────────────────────────────────────────────────────────────
# 규정 질문(AI, T-130) — 직원이 말로 물으면 시행 중 규정을 근거로 답한다
#
# ANTHROPIC_API_KEY = Anthropic API 키(https://console.anthropic.com). 비우면 이 기능만 "설정 안 됨".
#   질문할 때 질문과 관련 조문이 Anthropic(미국 — 처리 지역을 미국으로 고정)으로 전송된다(D-09 결정).
#   회사마다 꺼진 채 시작하고, 회사 관리자가 외부 전송 고지를 확인해야 켜진다(T-146, D-09 재결정).
#   운영에 키를 넣기 전에 질문 기록 파기 cron 을 먼저 건다(런북 7-9).
# AI_QA_MODEL = 쓸 모델. 비우면 claude-opus-5-5
# AI_QA_MONTHLY_LIMIT = 회사별 월 질문 한도. 비우면 300. AI 를 부르기 전에 세고(실패·거절도 센다),
#   AI 를 부르지 않고 끝난 질문(시행 중인 규정이 없을 때)만 돌려준다
# AI_QA_USER_MONTHLY_LIMIT = 직원 한 명의 월 질문 한도(한 사람이 회사 한도를 다 쓰지 못하게). 비우면 60
# AI_QA_PROVIDER = mock 이면 실제 AI 대신 모의 AI(통합 테스트용). 운영에서는 비운다
# 질문·답 기록은 90일 뒤 cron 이 부르는 파기 CLI 가 지운다(T-146). 보관 일수는 관리자가 동의한 고지에 실리므로
#   환경변수가 아니라 코드 상수다(ask-retention.ts — 바꾸면 ask-notice.ts 의 고지 판도 올린다)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_QA_MODEL=
AI_QA_MONTHLY_LIMIT=
AI_QA_USER_MONTHLY_LIMIT=
AI_QA_PROVIDER=

# ─────────────────────────────────────────────────────────────
# 데모 시드 (admin@demo.com / editor@ / viewer@ · 비밀번호 password123)
#
# 기본값 true — 로컬에서 바로 로그인해 볼 수 있도록 데모 테넌트를 만든다.
# 그 계정과 비밀번호는 리포에 그대로 적혀 있으므로 공개된 것과 같다.
#
# ★ 터널(cloudflared/tailscale)·상시 서버 등 **외부에서 접근 가능한 배포에서는 false**.
#   끄면 데모 계정이 생기지 않는다. 최초 조직은 아래로 만든다:
#     POST /api/auth/register  { tenantSlug, tenantName, email, password, name }
# ─────────────────────────────────────────────────────────────
SEED_DEMO_DATA=true

# Web (Vite): 법인명·사업자등록번호 — Docker로 web 이미지 빌드 시 compose가 아래 값을 build-arg로 넘깁니다.
# (로컬 `npm run dev`는 apps/web/.env 에 동일 이름으로 두면 됩니다.)
VITE_PUBLIC_COMPANY_LEGAL_NAME=
VITE_PUBLIC_COMPANY_REG_NO=

# ─────────────────────────────────────────────────────────────
# 시크릿 (운영 필수 교체)
#
# 아래 값을 비워두면 docker-compose.yml의 개발용 기본값이 쓰인다.
# 그 기본값은 리포에 그대로 적혀 있어 공개된 것과 같으므로,
# NODE_ENV=production 기동 시 API가 기본값을 감지하면 부팅을 거부한다.
# 생성: openssl rand -base64 48
# 절차: docs/Deliverables/16_Runbook_배포롤백/Runbook_배포롤백.md "시크릿 교체"
# ─────────────────────────────────────────────────────────────

# JWT — 서로 다른 값으로, 각각 32자 이상
JWT_SECRET=
JWT_REFRESH_SECRET=

# PostgreSQL (DATABASE_URL은 compose가 이 값들로 조립한다)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO (오브젝트 스토리지) — compose가 minio 서비스와 api에 같은 값을 넘긴다
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# 서버 밖 백업 (scripts/backup-offsite.sh)
#
# 규정 본문(DB)과 첨부파일은 **둘 다 이 서버 안에만** 있다. 서버가 사라지면
# 같이 사라지므로 매일 밖으로 내보낸다. S3 호환 저장소면 어디든 된다
# (Oracle Object Storage, AWS S3, 별도 MinIO).
#
# 이 값이 비어 있으면 백업 스크립트는 아무것도 하지 않고 종료 코드 1로 죽는다
# (조용히 넘어가면 백업이 없다는 걸 아무도 모른다).
# ─────────────────────────────────────────────────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# 저장 경로 접두사 (기본 policy-manager)
BACKUP_S3_PREFIX=
# 보관 일수 (기본 30)
BACKUP_KEEP_DAYS=
