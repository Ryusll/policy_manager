# Copy to .env — Docker Compose reads this for ${PUBLIC_URL} substitution.
# Cloud: set PUBLIC_URL to the URL users type in the browser (https://your-domain.com).

PUBLIC_URL=http://localhost

# Google OAuth (optional until you enable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only if the callback URL cannot be ${PUBLIC_URL}/api/auth/google/callback
# GOOGLE_CALLBACK_URL=

# ─────────────────────────────────────────────────────────────
# 법제처 국가법령정보 공동활용 OPEN API (규정 가져오기)
#
# 신청·발급: https://open.law.go.kr → OPEN API 신청 (승인까지 영업일 소요)
# LAW_GO_KR_OC = 발급받은 "인증값". 보통 신청한 이메일의 아이디 부분이다(예: hong@x.com → hong).
#
# ★ 인증값만으로는 부족하다. 법제처는 인증값과 **호출한 서버의 공인 IP**를 함께 검증한다.
#   배포 서버 IP를 open.law.go.kr 마이페이지 > API인증키관리에 등록하지 않으면
#   로컬에서 되던 호출이 운영에서 "사용자 정보 검증에 실패하였습니다"로 떨어진다.
#
# 비워두면 연동만 비활성화되고 나머지 기능은 그대로 동작한다(가져오기 화면에서 안내만 뜬다).
# ─────────────────────────────────────────────────────────────
LAW_GO_KR_OC=

# Web (Vite): 법인명·사업자등록번호 — Docker로 web 이미지 빌드 시 compose가 아래 값을 build-arg로 넘깁니다.
# (로컬 `npm run dev`는 apps/web/.env 에 동일 이름으로 두면 됩니다.)
VITE_PUBLIC_COMPANY_LEGAL_NAME=
VITE_PUBLIC_COMPANY_REG_NO=

# ─────────────────────────────────────────────────────────────
# 시크릿 (운영 필수 교체)
#
# 아래 값을 비워두면 docker-compose.yml의 개발용 기본값이 쓰인다.
# 그 기본값은 리포에 그대로 적혀 있어 공개된 것과 같으므로,
# NODE_ENV=production 기동 시 API가 기본값을 감지하면 부팅을 거부한다.
# 생성: openssl rand -base64 48
# 절차: docs/Deliverables/16_Runbook_배포롤백/Runbook_배포롤백.md "시크릿 교체"
# ─────────────────────────────────────────────────────────────

# JWT — 서로 다른 값으로, 각각 32자 이상
JWT_SECRET=
JWT_REFRESH_SECRET=

# PostgreSQL (DATABASE_URL은 compose가 이 값들로 조립한다)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO (오브젝트 스토리지) — compose가 minio 서비스와 api에 같은 값을 넘긴다
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
