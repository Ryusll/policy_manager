# 생성: python3 scripts/oracle/init-env.py https://실제호스트.ts.net
# 운영 파일 .env.oracle은 Git/Docker 빌드에서 제외된다.
PUBLIC_URL=
ORACLE_WEB_PORT=8080
POSTGRES_USER=policy_app
POSTGRES_DB=policy_manager
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
# 기존 API 시크릿 가드 호환용. Oracle 스택은 MinIO 서버를 실행하지 않는다.
MINIO_SECRET_KEY=

# 선택: Google 로그인 / 법제처 인증값 (새 서버 공인 IP를 법제처에 별도 등록)
LAW_GO_KR_OC=
VITE_PUBLIC_COMPANY_LEGAL_NAME=
VITE_PUBLIC_COMPANY_REG_NO=

# 서버 밖 백업: scripts/oracle/backup-offsite.sh
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=policy-manager-oracle
# Oracle Object Storage의 리전. AWS 등 다른 S3를 쓰면 해당 리전으로 변경.
BACKUP_S3_REGION=ap-seoul-1
