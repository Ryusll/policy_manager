{
  "name": "policy-manager",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "secrets:init": "node scripts/init-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:int:clean": "sh scripts/clean-test-tenants.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "fflate": "^0.8.2",
    "vitest": "^2.1.9"
  }
}
