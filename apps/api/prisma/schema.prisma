generator client {
  provider      = "prisma-client-js"
  // 컨테이너 베이스가 Debian(node:20-slim)이므로 debian 타깃이 필요하다.
  // musl 타깃은 Alpine을 쓰던 시절의 잔재라 제거 (Dockerfile 주석 참고)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  editor
  viewer
}

enum VersionStatus {
  draft
  review
  published
  archived
}

enum PlanTier {
  starter
  pro
  enterprise
}

enum PlatformRole {
  none
  global_admin
}

enum BillingStatus {
  active
  trial
  past_due
  canceled
}

enum PaymentStatus {
  succeeded
  failed
  refunded
}

enum SubscriptionStatus {
  active
  trial
  canceled
  expired
}

// 규정 본문 외 부칙·별표·서식 (국가법령정보 UI 구조에 맞춘 확장)
enum PolicyAppendixKind {
  supplementary
  annex
  form
}

model Tenant {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  plan          PlanTier      @default(starter)
  planExpiresAt DateTime?     @map("plan_expires_at")
  billingStatus BillingStatus @default(active) @map("billing_status")
  /// T-130 규정 근거 AI 질의응답 — 회사 관리자가 끌 수 있다(질문할 때 관련 조문이 외부 AI 로 간다)
  aiQaEnabled   Boolean       @default(true) @map("ai_qa_enabled")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  users                   User[]
  policies                Policy[]
  variables               Variable[]
  auditLogs               AuditLog[]
  comments                ArticleComment[]
  templates               PolicyTemplate[]
  importLogs              PolicyImportLog[]
  regulationParseSessions RegulationParseSession[]
  notificationGroups      NotificationGroup[]
  userNotifications       UserNotification[]
  billingCustomer         BillingCustomer?
  subscriptions           BillingSubscription[]
  payments                BillingPayment[]
  favorites               Favorite[]
  branding                TenantBranding?
  lawLinks                LawLink[]
  amendmentCandidates     AmendmentCandidate[]
  amendmentRevisions      AmendmentRevision[]
  amendmentStateChanges   AmendmentStateChange[]
  variableValues          VariableValue[]
  variableBindings        VariableBinding[]
  reparseReviews          ReparseReview[]
  aiQaLogs                AiQaLog[]

  @@map("tenants")
}

model User {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  email         String
  passwordHash  String?      @map("password_hash")
  name          String
  role          Role         @default(viewer)
  platformRole  PlatformRole @default(none) @map("platform_role")
  oauthProvider String?      @map("oauth_provider")
  oauthSub      String?      @map("oauth_sub")
  refreshToken  String?      @map("refresh_token")
  /// 다른 사람(관리자·아스트룸)이 정해 준 비밀번호로 만든·재설정한 계정이면 true.
  /// 본인이 비밀번호를 바꾸기 전까지 대부분의 API 가 막힌다 — 정해 준 사람이 비밀번호를 계속 알고
  /// 있는 상태로 쓰지 않게 하려는 것이다(T-122). 본인이 고르는 회원가입·비밀번호 변경은 false
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs                AuditLog[]
  comments                 ArticleComment[]
  importLogs               PolicyImportLog[]
  regulationParseSessions  RegulationParseSession[]
  notificationGroupMembers NotificationGroupMember[]
  userNotifications        UserNotification[]
  favorites                Favorite[]
  aiQaLogs                 AiQaLog[]

  @@unique([tenantId, email])
  @@unique([oauthProvider, oauthSub])
  @@map("users")
}

model Policy {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  code          String
  title         String
  description   String?
  isActive      Boolean   @default(true) @map("is_active")
  metadata      Json?
  revisionDate  DateTime? @map("revision_date") @db.Date
  effectiveDate DateTime? @map("effective_date") @db.Date
  templateId    String?   @map("template_id")
  /// 상위 규정. 규정 > 세칙 > 지침 체계를 자기참조 트리로 표현한다(T-71).
  /// 최상위는 null. 상위가 지워져도 하위는 남아야 하므로 SetNull.
  parentId      String?   @map("parent_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template               PolicyTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parent                 Policy?                  @relation("PolicyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children               Policy[]                 @relation("PolicyHierarchy")
  chapters               Chapter[]
  appendices             PolicyAppendix[]
  revisionReasons        PolicyRevisionReason[]
  importLogs             PolicyImportLog[]
  committedParseSessions RegulationParseSession[] @relation("CommittedParsePolicy")
  favorites              Favorite[]
  reparseReviews         ReparseReview[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@map("policies")
}

// PDF 파싱 세션: 추출 텍스트·트리 미리보기·수정 후 규정(Policy)으로 커밋
model RegulationParseSession {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  userId            String?  @map("user_id")
  fileName          String   @map("file_name")
  mimeType          String?  @map("mime_type")
  status            String   @default("pending")
  extractedText     String?  @map("extracted_text") @db.Text
  extractMeta       Json?    @map("extract_meta")
  parseTree         Json?    @map("parse_tree")
  errorMessage      String?  @map("error_message")
  committedPolicyId String?  @map("committed_policy_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  committedPolicy Policy? @relation("CommittedParsePolicy", fields: [committedPolicyId], references: [id], onDelete: SetNull)
  reparseReviews  ReparseReview[]

  @@index([tenantId, createdAt])
  @@map("regulation_parse_sessions")
}

/// 즐겨찾기 (T-80). 규정 또는 조문 하나를 사용자별로 저장한다.
/// 조문 즐겨찾기도 규정을 함께 들고 있어야 목록에서 "어느 규정의 몇 조"인지 바로 보인다.
model Favorite {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  policyId  String   @map("policy_id")
  /// 조문 즐겨찾기면 채워지고, 규정 즐겨찾기면 null
  articleId String?  @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy  Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// 같은 대상을 두 번 담지 못하게 한다. articleId 가 null 인 행(규정 즐겨찾기)은
  /// Postgres 에서 NULL 이 서로 다르게 취급되므로 서비스에서 한 번 더 확인한다.
  @@unique([userId, policyId, articleId])
  @@index([tenantId, userId, createdAt])
  @@map("favorites")
}

/// SaaS 운영사 표기(푸터·로그인 등). 고객사(tenant)와 무관한 단일 행
/// 테넌트(고객사) 브랜딩 — T-57.
/// 예전에는 브라우저 localStorage 에만 있어서 기기·브라우저를 바꾸면 사라지고
/// 팀원끼리 공유도 안 됐다(ADR-0003의 제한). 유료 기능이라 유실이 곧 클레임이다.
model TenantBranding {
  tenantId    String   @id @map("tenant_id")
  brandMark   String   @default("") @map("brand_mark") @db.VarChar(8)
  logoDataUrl String?  @map("logo_data_url") @db.Text
  logoWidth   Int      @default(32) @map("logo_width")
  logoHeight  Int      @default(32) @map("logo_height")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

model PlatformBranding {
  id             String   @id
  legalName      String   @default("") @map("legal_name") @db.VarChar(200)
  registrationNo String?  @map("registration_no") @db.VarChar(80)
  productLabel   String   @default("Policy Manager") @map("product_label") @db.VarChar(160)
  logoDataUrl    String?  @map("logo_data_url") @db.Text
  lockupImageSrc String   @default("/branding/lockup-astrum-veda.png") @map("lockup_image_src") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("platform_branding")
}

model PolicyAppendix {
  id        String             @id @default(uuid())
  policyId  String             @map("policy_id")
  kind      PolicyAppendixKind
  title     String
  body      String             @db.Text
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, kind])
  @@index([policyId, sortOrder])
  @@map("policy_appendices")
}

model PolicyTemplate {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  layoutJson  Json     @map("layout_json")
  cssText     String   @default("") @map("css_text")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policies Policy[]

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("policy_templates")
}

model Chapter {
  id             String   @id @default(uuid())
  policyId       String   @map("policy_id")
  number         Int
  title          String
  suppressHeader Boolean  @default(false) @map("suppress_header")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  policy   Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  articles Article[]
  sections Section[]

  @@map("chapters")
}

/// 절(節) — 선택 계층. 사내 규정은 법령의 편>장>절>조 구조를 반드시 따르지 않으므로
/// 조가 절에 속하지 않아도 된다(Article.sectionId 는 nullable). ADR-0011 참고
model Section {
  id        String   @id @default(uuid())
  chapterId String   @map("chapter_id")
  number    Int
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chapter  Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  articles Article[]

  @@index([chapterId, number])
  @@map("sections")
}

model Article {
  id                   String   @id @default(uuid())
  chapterId            String   @map("chapter_id")
  /// 절(선택 계층). null이면 절에 속하지 않는 조
  sectionId            String?  @map("section_id")
  number               Int
  /// 조의 가지 번호. "제3조의2"면 number=3, branchNumber=2. 가지 조문이 아니면 null.
  /// 개정으로 조 사이에 끼워 넣은 조문이라, 번호를 당기면 원문·법령 인용과 어긋난다.
  branchNumber         Int?     @map("branch_number")
  clauseNumber         Int?     @map("clause_number")
  itemNumber           Int?     @map("item_number")
  title                String
  hasPrecedent         Boolean  @default(false) @map("has_precedent")
  hasRelatedLaw        Boolean  @default(false) @map("has_related_law")
  hasRelatedRule       Boolean  @default(false) @map("has_related_rule")
  relatedPrecedentNote String?  @map("related_precedent_note") @db.Text
  relatedLawNote       String?  @map("related_law_note") @db.Text
  relatedRuleNote      String?  @map("related_rule_note") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  chapter   Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  section   Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  versions  ArticleVersion[]
  comments  ArticleComment[]
  favorites Favorite[]
  lawLinks  LawLink[]

  amendmentCandidates AmendmentCandidate[]
  variableBindings    VariableBinding[]
  /// 재파싱 검토에서 이 조문에 대응한 항목(T-110)
  reparseItems        ReparseReviewItem[] @relation("ReparseItemArticle")
  /// 재파싱 검토에서 사람이 이 조문을 골라 이은 항목(판정 보류 → 고르기, 새 조문 후보 → 잇기)
  reparseTargets      ReparseReviewItem[] @relation("ReparseItemTarget")

  @@map("articles")
}

model ArticleComment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  articleId  String   @map("article_id")
  userId     String   @map("user_id")
  content    String
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, articleId])
  @@map("article_comments")
}

model ArticleVersion {
  id            String        @id @default(uuid())
  articleId     String        @map("article_id")
  versionNum    Int           @map("version_num")
  content       String
  status        VersionStatus @default(draft)
  changeNote    String?       @map("change_note")
  /// 반려 사유(T-10). 검토자가 되돌려 보낸 까닭 — 없으면 편집자는 왜 반려됐는지 알 수 없다.
  /// 다시 검토 요청을 하면 지운다(이전 반려 사유가 남아 있으면 현재 상태를 잘못 읽는다).
  reviewNote    String?       @map("review_note") @db.Text
  /// 이 버전이 시행된 날. 시점 조회(as-of)의 기준. 승인 시 확정된다.
  effectiveDate DateTime?     @map("effective_date") @db.Date
  approvedBy    String?       @map("approved_by")
  approvedAt    DateTime?     @map("approved_at")
  createdBy     String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  /// 발행일 — 시스템에서 시행본으로 발행한 시각(T-108, 특허 청구항 7). 시행일(effectiveDate)·법령 시행일과
  /// 다르다. 시점 조회의 기준은 여전히 시행일이다. T-108 이전에 발행된 버전은 비어 있다(보정은 T-111)
  publishedAt   DateTime?     @map("published_at")
  /// 이 버전을 낳은 법령 변경 이벤트 — 개정 후보 승인으로 발행됐을 때만(T-108)
  changeEventId String?       @map("change_event_id")
  /// 이 버전을 낳은 개정 후보 — 승인 이력의 원천(T-108). 후보 쪽에는 따로 두지 않고 이 관계로 찾는다
  sourceCandidateId String?   @unique @map("source_candidate_id")
  /// 폐지 시행일(T-126) — "게시본 폐지"로 내린 버전만 있다. 이 날부터 조문은 시행 중이 아니다.
  /// 새 버전에 밀려 내려간(대체) 버전은 비어 있다 — 상태(archived)만으로는 둘을 가를 수 없다
  repealedOn    DateTime?     @map("repealed_on") @db.Date
  /// 버전별 계층(T-110 ②, PAT-04 최소안) — 발행 이력이면 그 버전이 시행된 동안의 **얼린 계층**(계층이 실제로 바뀐 승인 때 채운다,
  /// 비어 있으면 지금 조문 행의 값), 초안·검토 중이면 재파싱이 **제안한 계층**(승인 때 조문 행으로 옮기고 비운다). 시행본은 늘 비어 있다
  structure     Json?
  /// 이 버전을 만든 재파싱 검토 항목(T-110 ②) — 묶음으로만 검토 요청·승인·반려한다(단건 처리·한꺼번에 시행에서 빠진다)
  reparseItemId String?       @unique @map("reparse_item_id")

  article          Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// 이 버전 본문의 변수 연결(T-109) — 위치는 이 버전 기준
  variableBindings VariableBinding[]
  /// 이 버전을 제1 조문(기준 발행본)으로 삼은 개정 후보(T-106)
  amendmentBases AmendmentCandidate[] @relation("AmendmentBase")
  changeEvent     LawChangeEvent?     @relation(fields: [changeEventId], references: [id], onDelete: SetNull)
  sourceCandidate AmendmentCandidate? @relation("AmendmentResult", fields: [sourceCandidateId], references: [id], onDelete: SetNull)
  reparseItem     ReparseReviewItem?  @relation("ReparseItemVersion", fields: [reparseItemId], references: [id], onDelete: SetNull)

  /// 시점 조회: 조문별로 "기준일 이전 시행분 중 가장 최근" 버전을 찾는다
  @@unique([articleId, versionNum])
  @@index([articleId, effectiveDate])
  @@map("article_versions")
}

/// 제정·개정 이유(개정문). 법령의 "제정·개정이유"에 해당하는 문서 단위 기록.
/// 조문 단위 사유는 `ArticleVersion.changeNote`가 담당한다.
model PolicyRevisionReason {
  id              String             @id @default(uuid())
  policyId        String             @map("policy_id")
  kind            PolicyRevisionKind @default(amendment)
  /// 개정 차수 표시용 라벨 (예: "제3차 일부개정")
  label           String
  /// 개정 이유 본문
  reason          String             @db.Text
  /// 주요 변경사항 요약 (선택)
  summary         String?            @db.Text
  promulgatedDate DateTime?          @map("promulgated_date") @db.Date
  effectiveDate   DateTime?          @map("effective_date") @db.Date
  createdBy       String?            @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, effectiveDate])
  @@map("policy_revision_reasons")
}

enum PolicyRevisionKind {
  /// 제정
  enactment
  /// 일부개정
  amendment
  /// 전부개정
  full_amendment
  /// 폐지
  repeal
}

/// 변수 마스터 — 여러 조문에 함께 쓰는 가변 항목(담당 부서·직위·기준값 등) (특허 청구항 5·9, 도 9 910).
/// 값은 `VariableValue` 에 유효기간과 함께 여럿 둔다(T-109). 회사(테넌트) 소유라 값의 범위도 그 회사다.
model Variable {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  key         String
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values   VariableValue[]
  bindings VariableBinding[]

  @@unique([tenantId, key])
  @@map("variables")
}

/// 변수 값 — 유효기간 [시작, 종료)(T-109, 도 9). 종료일이 다음 값의 시작일과 같으면 그날은 다음 값이다.
/// 같은 변수에서 기간이 겹쳐도 저장은 받되 "검토 필요"로 보이고, 그 날짜에 맞는 값이 **정확히 하나**일 때만 고른다.
model VariableValue {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  variableId      String    @map("variable_id")
  value           String
  /// 유효기간 시작(포함). null = 처음부터
  validFrom       DateTime? @map("valid_from") @db.Date
  /// 유효기간 종료(미포함). null = 끝 없음
  validTo         DateTime? @map("valid_to") @db.Date
  /// 기간을 확인했는가 — 옛 기본값(defaultValue)을 옮긴 값은 false 로 들어와, 관리자가 기간을 정하기 전에는
  /// 고르지 않는다("처음부터"와 "모름"은 다르다)
  periodConfirmed Boolean   @default(true) @map("period_confirmed")
  note            String?
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variable Variable          @relation(fields: [variableId], references: [id], onDelete: Cascade)
  bindings VariableBinding[]

  @@index([variableId, validFrom])
  @@map("variable_values")
}

/// 변수 연결이 생긴 길 — 화면에서 문구를 골라 이음 / 검토 요청 때 표식을 값으로 바꿔 이음 / 옛 사용 기록을 옮김 /
/// 발행 때 앞 버전에서 옮겨 옴
enum VariableBindingOrigin {
  manual
  marker
  legacy
  inherited
}

/// active — 쓴다 / needs_review — 위치를 확정하지 못해 사람이 다시 이어야 한다 / released — 연결을 풀었다(이력으로 남김)
enum VariableBindingState {
  active
  needs_review
  released
}

/// 변수 연결(바인딩) — 조문 버전 본문의 한 구간이 어느 변수의 값인지 (T-109, 특허 도 9 920).
/// 위치는 **그 버전 본문 기준** UTF-16 [start, end). 같은 문구가 여러 번 나와도 위치로 가른다(순번·앞뒤 문맥은 화면 표시·다시 잇기용).
/// 새 버전이 발행되면 위치를 옮긴 새 행을 그 버전에 만들고(parentId 로 이어짐) 옛 행은 그대로 둔다.
model VariableBinding {
  id            String                @id @default(uuid())
  tenantId      String                @map("tenant_id")
  variableId    String                @map("variable_id")
  articleId     String                @map("article_id")
  /// 기준 조문 버전
  versionId     String                @map("version_id")
  start         Int
  end           Int
  /// 그 구간의 당시 문구 — 표식이면 "{{KEY}}"
  text          String
  contextBefore String                @map("context_before")
  contextAfter  String                @map("context_after")
  /// 같은 문구 중 몇 번째 출현인지(0부터)
  occurrence    Int
  origin        VariableBindingOrigin
  state         VariableBindingState  @default(active)
  /// needs_review 의 까닭(span_changed·legacy_unmatched·position_unverified)
  reviewReason  String?               @map("review_reason")
  /// 이 구간에 든 값(알 때) — 다음에 값을 반영할 때 "직전 적용값"을 확인한다
  valueId       String?               @map("value_id")
  /// 앞 버전의 연결(발행 때 옮겨 온 경우)
  parentId      String?               @map("parent_id")
  createdBy     String?               @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variable Variable          @relation(fields: [variableId], references: [id], onDelete: Cascade)
  article  Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version  ArticleVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  value    VariableValue?    @relation(fields: [valueId], references: [id], onDelete: SetNull)
  parent   VariableBinding?  @relation("BindingLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children VariableBinding[] @relation("BindingLineage")

  @@index([versionId, state])
  @@index([variableId, state])
  @@index([articleId])
  @@map("variable_bindings")
}

/// 알림 수신 팀(예: 정보보안팀) — 테넌트별, 구성원은 User와 N:M
model NotificationGroup {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members NotificationGroupMember[]

  @@unique([tenantId, name])
  @@map("notification_groups")
}

model NotificationGroupMember {
  groupId String @map("group_id")
  userId  String @map("user_id")

  group NotificationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("notification_group_members")
}

/// 규정 개정·시행 승인 등 사용자별 인앱 알림
model UserNotification {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  kind      String    @default("policy_revision")
  title     String
  body      String    @db.Text
  policyId  String?   @map("policy_id")
  articleId String?   @map("article_id")
  versionId String?   @map("version_id")
  /// 규정이 아닌 화면으로 가는 알림의 이동 경로(예: 법령 개정 후보 → `/laws/:id?change=`)
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([tenantId, createdAt])
  @@map("user_notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model PolicyImportLog {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  userId         String?  @map("user_id")
  policyId       String?  @map("policy_id")
  sourceName     String?  @map("source_name")
  parseProfile   String?  @map("parse_profile")
  chapterCount   Int      @default(0) @map("chapter_count")
  articleCount   Int      @default(0) @map("article_count")
  cleanupOptions Json?    @map("cleanup_options")
  status         String   @default("success")
  message        String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  policy Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("policy_import_logs")
}

model BillingCustomer {
  id                 String   @id @default(uuid())
  tenantId           String   @unique @map("tenant_id")
  provider           String   @default("mock")
  providerCustomerId String?  @map("provider_customer_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions BillingSubscription[]
  payments      BillingPayment[]

  @@index([provider, providerCustomerId])
  @@map("billing_customers")
}

model BillingSubscription {
  id                     String             @id @default(uuid())
  tenantId               String             @map("tenant_id")
  billingCustomerId      String?            @map("billing_customer_id")
  provider               String             @default("mock")
  providerSubscriptionId String?            @map("provider_subscription_id")
  plan                   PlanTier
  status                 SubscriptionStatus @default(active)
  startedAt              DateTime           @default(now()) @map("started_at")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingCustomer BillingCustomer? @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  payments        BillingPayment[]

  @@index([tenantId, status])
  @@index([provider, providerSubscriptionId])
  @@index([currentPeriodEnd])
  @@map("billing_subscriptions")
}

model BillingPayment {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  billingCustomerId String?       @map("billing_customer_id")
  subscriptionId    String?       @map("subscription_id")
  provider          String        @default("mock")
  providerPaymentId String?       @map("provider_payment_id")
  providerOrderId   String?       @map("provider_order_id")
  amount            Int
  currency          String        @default("KRW")
  status            PaymentStatus @default(succeeded)
  paidAt            DateTime?     @map("paid_at")
  refundAt          DateTime?     @map("refund_at")
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingCustomer BillingCustomer?     @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  subscription    BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status, paidAt])
  @@index([provider, providerPaymentId])
  @@map("billing_payments")
}

// ─────────────────────────────────────────────────────────────
// S7 법령 개정 연계 — 법령 엔티티 (T-100)
//
// ⚠️ 이 세 테이블에는 tenantId 가 없다. 근로기준법은 모든 고객사에 같은 내용이므로
//    테넌트마다 복사하면 같은 법을 고객사 수만큼 조회하게 된다 (ADR-0020).
//    대신 법령조항 id 로 시작하는 조회는 LawLink.tenantId 에서 경계를 걸어야 한다(T-101).
// ─────────────────────────────────────────────────────────────

/// 법령원 — 법령 데이터를 제공하는 외부 출처 (청구항 3의 "법령원 식별자")
model LawSource {
  id        String   @id @default(uuid())
  /// "law.go.kr"
  code      String   @unique
  name      String
  baseUrl   String   @map("base_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  laws Law[]

  @@map("law_sources")
}

/// 법령 — 테넌트 공용
model Law {
  id              String    @id @default(uuid())
  sourceId        String    @map("source_id")
  /// 법제처 MST(법령일련번호). 본문 조회 키다
  externalId      String    @map("external_id")
  /// 법령ID — MST 와 다르다. 개정되면 MST 는 바뀌고 법령ID 는 유지된다
  externalLawId   String?   @map("external_law_id")
  lawName         String    @map("law_name")
  lawNo           String?   @map("law_no")
  /// '법률' · '대통령령' · '부령' 등
  lawType         String?   @map("law_type")
  ministry        String?
  promulgatedDate DateTime? @map("promulgated_date") @db.Date
  /// 법령 시행일 (≠ 사내 규정 시행일)
  effectiveDate   DateTime? @map("effective_date") @db.Date
  /// 현재 수신본의 지문. 이 값이 바뀌면 개정이다 (조항 지문을 순서대로 이어 해시)
  versionKey      String?   @map("version_key")
  /// 마지막 확인 시도 시각. T-104 가 오래된 순으로 고른다 — 실패해도 갱신해야
  /// 고장 난 법령 하나가 매번 맨 앞에 서서 나머지를 막지 않는다
  lastCheckedAt   DateTime? @map("last_checked_at")
  /// 마지막 확인이 실패했으면 그 사유, 성공했으면 null.
  /// "개정 없음"과 "확인 못 함"을 화면에서 구별하려고 둔다(법제처는 실패도 HTTP 200 이다)
  lastCheckError  String?   @map("last_check_error") @db.Text
  sourceUrl       String?   @map("source_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  source       LawSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  articles     LawArticle[]
  changeEvents LawChangeEvent[]

  @@unique([sourceId, externalId])
  @@index([lastCheckedAt])
  @@map("laws")
}

/// 법령조항 — 청구항의 "법령조항 식별자"는 이 레코드의 id
model LawArticle {
  id    String @id @default(uuid())
  lawId String @map("law_id")

  /// 조·항·호를 한 문자열로 표현한 식별자. 가지번호를 포함한다
  /// (예: `3의2/1/2` = 제3조의2 제1항 제2호, `5//` = 제5조).
  ///
  /// 설계안은 `@@unique([lawId, articleNo, clauseNo, itemNo])` 였는데 두 가지가 깨진다:
  ///  1. Postgres 는 UNIQUE 에서 NULL 을 서로 다른 값으로 본다. 조 본문 행은
  ///     (clauseNo, itemNo) 가 둘 다 NULL 이라 **중복이 전혀 막히지 않는다**.
  ///  2. `articleNo Int` 로는 제3조와 제3조의2 를 구분할 수 없다.
  /// 그래서 식별은 이 컬럼 하나로 하고, 아래 숫자 컬럼은 조회·정렬용으로 남긴다.
  nodeKey String @map("node_key")

  /// 조
  articleNo Int  @map("article_no")
  /// 항. 조 본문 행이면 null
  clauseNo  Int? @map("clause_no")
  /// 호. 항(또는 조) 본문 행이면 null
  itemNo    Int? @map("item_no")

  /// 사람이 읽는 표기 ("제3조의2제1항제2호")
  label   String
  title   String?
  content String  @db.Text

  /// 내용 지문. 변경 감지(T-103)의 기준. `v<정규화규칙버전>:<sha256>` 형식
  versionKey    String    @map("version_key")
  effectiveDate DateTime? @map("effective_date") @db.Date
  /// 원문 순서
  sortOrder     Int       @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  law Law @relation(fields: [lawId], references: [id], onDelete: Cascade)
  links LawLink[]
  /// onDelete: SetNull — 조문이 삭제되는 개정에서도(register() 의 deleteMany) 그
  /// "삭제됨" 이벤트 자체는 남아야 한다. 본문은 이벤트에 스냅샷으로 이미 들어 있어
  /// FK 가 끊겨도 잃는 정보가 없다
  changeEvents LawChangeEvent[]

  @@unique([lawId, nodeKey])
  @@index([lawId, sortOrder])
  @@map("law_articles")
}

/// 법령 관계 정보 — 법령조항과 사내 조문을 잇는다 (T-101).
///
/// ⚠️ 테넌트별 데이터다. `LawArticle`에는 tenantId 가 없으므로(테넌트 공용, ADR-0020),
/// **법령조항 id 로 시작하는 조회는 여기서 경계를 건다.** T-41 감사에서 찾은 2건과
/// 같은 형태의 실수가 가능한 지점이다 — 부모(LawArticle)만 보고 자식 관계(LawLink)의
/// tenantId 를 빠뜨리면 다른 회사의 규정 구조가 새어 나간다.
model LawLink {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  lawArticleId String @map("law_article_id")
  /// 사내 조문. Article 자체에는 tenantId 가 없다(chapter→policy 경유) — 생성 시
  /// chapter.policy.tenantId 로 소유를 확인한 뒤에만 저장한다(laws-link.service.ts)
  articleId    String @map("article_id")

  relationType LawRelationType @map("relation_type")
  /// 적용 범위 (예: "정규직에 한함"). 선택
  scope        String?         @db.Text
  /// 관계의 근거 문구 — 본문에서 이 연결을 뒷받침하는 문장
  evidenceText String?         @map("evidence_text") @db.Text
  /// 신뢰도 0.0~1.0. 자동 추천(suggest)일 때만 채워진다
  confidence   Float?
  confirmState LawLinkState    @default(suggested) @map("confirm_state")
  confirmedBy  String?         @map("confirmed_by")
  confirmedAt  DateTime?       @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawArticle LawArticle @relation(fields: [lawArticleId], references: [id], onDelete: Cascade)
  article    Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  amendmentCandidates AmendmentCandidate[]

  @@unique([tenantId, lawArticleId, articleId])
  /// 조문 상세에서 "이 조문이 걸린 법" 보기
  @@index([tenantId, articleId])
  /// 영향 분석(T-105)의 진입 경로 — 법령조항 id 에서 출발해 확정된 링크만 훑는다
  @@index([lawArticleId, confirmState])
  @@map("law_links")
}

enum LawRelationType {
  /// 위임 — 법이 규정에 위임한 사항
  delegation
  /// 준용
  application
  /// 인용 — 규정이 법 조항을 직접 인용
  citation
  /// 의무 — 법이 정한 의무를 규정이 구체화
  obligation
  /// 참고
  reference
}

enum LawLinkState {
  /// 자동 추천 — 사람이 아직 확인하지 않았다. 영향 분석(T-105)은 이 상태를 쓰지 않는다
  suggested
  /// 사용자 확정
  confirmed
  /// 사용자가 아니라고 판단
  rejected
}

/// 변경 이벤트 — 청구항 1 ③, 청구항 3. `LawsService.register()` 가 재등록마다
/// 조항별 versionKey 를 비교해 만든다(T-103).
///
/// 설계안(18절)은 `lawArticleId` 하나만 두고 필수로 뒀는데, 실제로 만들면서 둘을 더했다.
///  1. `lawId` 를 직접 들고 있다 — `lawArticleId` 가 조문 삭제로 null 이 될 수 있어서다
///     (아래), 그때도 "어느 법인지"는 남아야 "법령·법령조항 식별자" 요건이 유지된다.
///  2. `nodeKey` 를 복사해 둔다 — 같은 이유로, 삭제된 조문을 사람이 읽을 표기로 남긴다.
/// `changeType` 은 설계안에 없었지만 대장의 DoD("조항 신설·삭제")가 명시적으로 구분해야
/// 하는 결과라 필드로 뒀다 — before/after 가 null 인지로 매번 되짚게 하지 않는다.
model LawChangeEvent {
  id     String @id @default(uuid())
  lawId  String @map("law_id")
  /// 조문이 나중에 삭제되면 SetNull 로 끊긴다. 그래도 이벤트 자체(스냅샷)는 남는다
  lawArticleId String? @map("law_article_id")
  /// `LawArticle.nodeKey` 복사본. lawArticleId 가 null 이 된 뒤에도 "어느 조문인지" 표기용
  nodeKey String @map("node_key")

  changeType LawChangeType @map("change_type")
  /// 변경 전 본문. 신설(created)이면 null
  beforeContent String? @map("before_content") @db.Text
  /// 변경 후 본문. 삭제(deleted)면 null
  afterContent String? @map("after_content") @db.Text
  beforeVersionKey String? @map("before_version_key")
  afterVersionKey  String? @map("after_version_key")

  /// 공포일 — 이 변경을 발생시킨 개정의 공포일(법령 단위 값, 조문별 값은 법제처가 안 줌)
  promulgatedDate DateTime? @map("promulgated_date") @db.Date
  /// 법령 시행일. 사내 규정 시행일(ArticleVersion.effectiveDate)과 다르다
  lawEffectiveDate DateTime? @map("law_effective_date") @db.Date
  /// 수신경로 — T-104 가 poll 을 쓴다. 지금은 register() 호출부가 전부 manual
  receivedVia LawEventChannel @map("received_via")
  detectedAt  DateTime        @default(now()) @map("detected_at")

  /// 개정 후보 자동 생성(T-106)을 마친 시각. null 이면 아직 — 동기화가 끝날 때마다 null 인 것을
  /// 다시 처리한다(중간에 끊기거나 한 회사가 실패해도 다음 실행에서 이어진다). 기능 도입 전에
  /// 감지된 이벤트는 마이그레이션이 감지 시각으로 채워 두었다(한꺼번에 알림이 쏟아지지 않게) —
  /// 그 이벤트의 후보는 화면에서 직접 만든다
  amendmentsProcessedAt DateTime? @map("amendments_processed_at")

  law        Law         @relation(fields: [lawId], references: [id], onDelete: Cascade)
  lawArticle LawArticle? @relation(fields: [lawArticleId], references: [id], onDelete: SetNull)
  candidates AmendmentCandidate[]
  /// 이 변경으로 발행된 사내 조문 버전(T-108)
  versions   ArticleVersion[]

  /// 조문 상세 이력, 영향 분석(T-105)의 "이 법령조항 최근 변경" 조회
  @@index([lawArticleId, detectedAt])
  /// 법령 단위 동기화 이력(T-104)
  @@index([lawId, detectedAt])
  @@index([lawEffectiveDate])
  /// 자동 생성이 아직 처리하지 않은 이벤트 찾기
  @@index([amendmentsProcessedAt])
  @@map("law_change_events")
}

enum LawChangeType {
  /// 신설 — 이전 등록에 없던 조문
  created
  /// 실제 내용 변경 (공백만 다르면 versionKey 가 같아 여기 안 걸린다)
  modified
  /// 삭제 — 이번 등록 응답에서 사라진 조문
  deleted
}

enum LawEventChannel {
  /// 주기 조회로 발견 (T-104)
  poll
  /// 담당자가 직접 등록(현재 register() 의 유일한 경로)
  manual
  /// 외부 통지 — 미사용, 확장 여지
  webhook
}

/// 법령 주기 동기화 1회 실행 기록 (T-104).
/// 동기화가 조용히 실패하면 "개정이 없었다"와 구별되지 않는다 — 실행마다 남기고, 실패를 숫자로 보인다.
model LawSyncRun {
  id           String         @id @default(uuid())
  trigger      LawSyncTrigger
  status       LawSyncStatus  @default(running)
  /// 수동 실행한 사용자(global_admin). 예약 실행이면 null
  triggeredBy  String?        @map("triggered_by")
  startedAt    DateTime       @default(now()) @map("started_at")
  finishedAt   DateTime?      @map("finished_at")
  /// 확인한 법령 수
  checkedCount Int            @default(0) @map("checked_count")
  /// 새 판(다른 MST)이 있었던 법령 수
  changedCount Int            @default(0) @map("changed_count")
  /// 만들어진 LawChangeEvent 수
  eventCount   Int            @default(0) @map("event_count")
  failedCount  Int            @default(0) @map("failed_count")
  /// 법령별 결과 `[{ lawId, lawName, outcome, fromMst, toMst, events, error }]`
  results      Json?
  /// 실행 전체가 실패한 사유(법령별 사유는 results 에)
  error        String?        @db.Text

  @@index([startedAt])
  @@map("law_sync_runs")
}

enum LawSyncTrigger {
  /// cron — 서버의 scripts/oracle/law-sync.sh
  schedule
  /// 플랫폼 관리자가 화면에서 실행
  manual
}

enum LawSyncStatus {
  running
  /// 확인한 법령이 모두 성공 (0건 포함)
  succeeded
  /// 일부 실패
  partial
  /// 전부 실패
  failed
}

/// 개정 후보 — 특허 청구항 6 의 후보 레코드 (T-106, 설계안 4.3).
///
/// **발행 버전과 따로 둔다.** 후보는 시점 조회·전문·인쇄에 나오지 않고, 승인(T-108)될 때에만
/// 같은 조문(`articleId`)의 후속 버전이 된다. 근거(`rationale`)·비교(`diff`)는 만들 때의 스냅샷이라
/// 나중에 연결·법령 본문이 바뀌어도 "그때 왜 이렇게 고쳤는지"가 남는다.
model AmendmentCandidate {
  id            String  @id @default(uuid())
  /// ⚠️ 테넌트 경계. 조문의 실제 소속(chapter→policy→tenant)과 같아야 한다 — 만들 때 둘 다 본다
  tenantId      String  @map("tenant_id")
  /// 영향 조문 (조문 식별자)
  articleId     String  @map("article_id")
  /// 제1 조문 — 만들 때의 기준 발행본. 그 뒤 새 버전이 시행돼도 바꾸지 않는다
  baseVersionId String  @map("base_version_id")
  /// 만들 때 그 조문의 발행 이력 지문 — 시행본·폐지본의 id·상태·시행일·버전 번호(T-108). 승인 때 다시 계산해
  /// 다르면 그 사이 다른 발행이 있었다는 뜻이라 막는다. T-108 이전 후보는 비어 있다
  baseFingerprint String? @map("base_fingerprint")
  changeEventId String  @map("change_event_id")
  /// 영향을 찾은 연결. 연결이 지워져도 후보는 남는다(근거는 rationale 에 스냅샷) — 법령조항이
  /// 개정으로 사라지면 연결이 cascade 로 지워지는데, 그때 동기화가 막히면 안 된다
  lawLinkId     String? @map("law_link_id")

  /// 제2 조문 — 개정 후보 본문. 반영한 것이 없으면 제1 조문 그대로(reviewFlags 에 manual_draft_required)
  candidateContent String              @map("candidate_content") @db.Text
  /// 변경 근거 정보 — 법령 변경 부분·연결(유형·근거 문구·확정 상태)·경로·적용 규칙·반영 못 한 변경
  rationale        Json
  /// 변경 전후 비교 정보 — 제1 조문 대 후보의 실제 차이(문자 구간). 규칙 기록과 따로 계산한다
  diff             Json
  generationMethod AmendmentMethod     @map("generation_method")
  /// 같은 생성 방식 안의 개정안 구분. 규칙 기반은 규칙 세트 버전("rule/1") — 다시 눌러도 같은 값이라
  /// 같은 후보가 또 생기지 않고, 규칙 세트가 바뀌면 새 개정안이 된다
  variant          String
  /// 규칙·템플릿과 버전, 입력 원천(이벤트·전후 판 키·조문·발행본·연결·기준일), 신뢰도 판정 근거
  generationMeta   Json?               @map("generation_meta")
  /// 후보 신뢰도(검토 보조) — 관계 신뢰도(LawLink.confidence)와 별개다
  confidence       AmendmentConfidence
  /// 사람이 봐야 하는 이유. amendment-rules.ts 의 ReviewFlag
  reviewFlags      String[]            @default([]) @map("review_flags")
  reviewState      AmendmentState      @default(draft) @map("review_state")
  /// 지금 본문의 판 번호 — 생성본이 1, 사람이 고칠 때마다 1씩 오른다(T-107). 판마다의 본문은 AmendmentRevision
  revision         Int                 @default(1)
  /// 낙관적 잠금 — 손질·검토 요청처럼 후보가 바뀔 때마다 1씩 오른다. 화면이 본 값과 다르면 409
  lockVersion      Int                 @default(0) @map("lock_version")
  /// 영향 분석 기준일 — 제1 조문을 고른 날
  asOfDate         DateTime            @map("as_of_date") @db.Date
  /// 예정 사내 규정 시행일(T-109 ②) — 변수 값을 고르는 날. 법령 시행일·영향 분석 기준일과 다르다. 승인 때 확정하는
  /// 시행일은 따로 받고, 그 날의 변수 값이 이 후보와 다르면 승인하지 않는다(409 variable_changed)
  plannedEffectiveDate DateTime        @map("planned_effective_date") @db.Date
  /// 변수 입력의 지문(T-109 ②) — 연결·고른 값·결과. 연결이 없으면 빈 값. 같은 기준 본문이라도 값만 달라진 후보를 가른다
  variableFingerprint String           @default("") @map("variable_fingerprint")
  /// 만든 사람. 동기화가 자동으로 만들었으면 null
  createdBy        String?             @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article     Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  baseVersion ArticleVersion @relation("AmendmentBase", fields: [baseVersionId], references: [id], onDelete: Cascade)
  /// Restrict — 이벤트가 지워지면 개정의 원인이 사라진다. 법령 추적 해제는 후보가 있으면 거부한다
  changeEvent LawChangeEvent @relation(fields: [changeEventId], references: [id], onDelete: Restrict)
  lawLink     LawLink?       @relation(fields: [lawLinkId], references: [id], onDelete: SetNull)

  revisions    AmendmentRevision[]
  stateChanges AmendmentStateChange[]
  /// 승인으로 발행된 후속 버전(T-108) — ArticleVersion.sourceCandidateId 의 역관계
  resultVersion ArticleVersion? @relation("AmendmentResult")

  /// 같은 이벤트·조문·기준 발행본·발행 이력·방식·개정안은 하나 — 자동 생성과 버튼이 겹쳐도 중복이 안 생긴다.
  /// 발행 이력 지문이 들어간 것은, 기준 본문은 같아도 그 사이 다른 발행이 있었으면 "다시 만들기"가 새 후보를
  /// 만들게 하려는 것이다(같은 낡은 후보만 되돌려 주지 않게)
  @@unique([tenantId, changeEventId, articleId, baseVersionId, baseFingerprint, generationMethod, variant, plannedEffectiveDate, variableFingerprint])
  @@index([tenantId, reviewState, createdAt])
  @@index([tenantId, articleId])
  @@index([changeEventId])
  @@map("amendment_candidates")
}

/// 개정 후보의 판 — 생성본(판 1)부터 사람이 고칠 때마다 하나씩 쌓고 **바꾸지 않는다** (T-107, 특허 도 11).
/// 수정 전 내용은 직전 판이다. 승인(T-108)은 사람이 확인한 판에 대해서만 유효하다
model AmendmentRevision {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  candidateId String  @map("candidate_id")
  revision    Int
  /// 이 판의 후보 본문
  content     String  @db.Text
  /// 본문 SHA-256(hex) — 감사 기록·승인 대상 식별용(복원 수단이 아니다, 본문은 이 행에 있다)
  contentHash String  @map("content_hash")
  /// 제1 조문 대 이 판의 비교 정보 — 손질한 판은 규칙 근거를 다시 이은 것
  diff        Json
  /// 수정 사유 — 사람이 고친 판은 필수, 생성본(판 1)은 없다
  note        String? @db.Text
  /// 고친 사람. 생성본이면 null(만든 사람은 후보의 createdBy)
  editedBy    String? @map("edited_by")
  /// 고치기 전 상태 — 검토 중이던 후보를 고치면 review 이고, 고친 뒤에는 작성으로 돌아간다
  stateBefore AmendmentState? @map("state_before")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate AmendmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, revision])
  @@index([tenantId, candidateId])
  @@map("amendment_revisions")
}

/// 개정 후보의 상태 전환 기록 — 검토 요청, 손질로 인한 검토 취소, 반려·승인(T-108). 본문이 바뀌지 않는
/// 전환도 남아야 해서 판과 따로 둔다. 진행 중인 검토 요청은 "검토 상태일 때 가장 최근의 → review 전환"이다
model AmendmentStateChange {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  candidateId String         @map("candidate_id")
  fromState   AmendmentState @map("from_state")
  toState     AmendmentState @map("to_state")
  /// 이 전환이 가리키는 판 — 검토 요청이면 검토 대상 판
  revision    Int
  /// 요청 사유(본문 차이가 없으면 필수)·취소 사유·반려 사유
  reason      String?        @db.Text
  actorId     String?        @map("actor_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate AmendmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
  @@map("amendment_state_changes")
}

enum AmendmentMethod {
  /// 제1 생성 방식 — 개정 규칙 + 문장 템플릿 (T-106)
  rule
  /// 제2 생성 방식 — 언어모델 (T-112)
  llm
}

enum AmendmentState {
  /// 작성 — 만들어졌거나 손질 중
  draft
  /// 검토 요청됨 (T-107)
  review
  /// 승인 → 후속 버전 발행 (T-108)
  approved
  /// 반려 — 발행 보류 (T-108)
  rejected
}

enum AmendmentConfidence {
  /// 대응·근거가 확인되고 대상 변경을 모두 반영
  high
  /// 확실한 일부만 반영
  medium
  /// 반영 없음, 또는 충돌·모호·근거 없는 변경이 있음
  low
}

/// 재파싱 검토(T-110, 특허 청구항 2·도 6) — 규정 문서를 다시 가져와 대상 규정의 조문과 맞춘 결과와 사람의 결정.
/// 판정은 계층 정보와 내용 지문(비교 대상 버전 본문의 정규화 결과) 두 축으로 하고, 조문 식별자는 지문이 아니라 이 판정으로
/// 유지된다. 비교할 때의 규정 상태 지문을 남겨 두고 반영·승인 때 다시 계산해 그 사이 바뀌었으면 다시 비교하게 한다
model ReparseReview {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  /// 대상 규정(규정 식별 정보) — 파일명과 따로 사람이 고른다
  policyId         String   @map("policy_id")
  sessionId        String?  @map("session_id")
  /// 원문 출처 이름(업로드 파일명·법제처 법령명)
  sourceName       String   @map("source_name")
  /// open(결정 중) | superseded(같은 원문을 다시 비교함) | applied(반영함 — 묶음 초안·계획) | submitted(묶음 검토 요청)
  /// | approved(묶음 승인 — 후속 버전 발행) | rejected(묶음 반려)
  status           String   @default("open")
  /// 판정 규칙(reparse/1)·정규화 규칙(norm/1) 버전
  algorithm        String
  normalizer       String
  /// 비교할 때의 규정 상태 지문 — 장·절·조문 계층과 제목, 비교 대상 버전·작업본
  stateFingerprint String   @map("state_fingerprint")
  /// 종류별 개수·장 대응·부칙 개수
  summary          Json
  createdBy        String?  @map("created_by")
  /// 반영 계획(T-110 ②) — 승인 때 만들 장·절, 기존 장의 번호·제목 변경
  plan             Json?
  /// 묶음 지문 — 반영·검토 요청 때의 규정 상태(계층·발행 이력·작업본, 검토 요청 뒤엔 묶음 본문까지). 다음 단계에서 다시 계산해 다르면 409
  bundleFingerprint String?  @map("bundle_fingerprint")
  appliedAt        DateTime? @map("applied_at")
  appliedBy        String?   @map("applied_by")
  submittedAt      DateTime? @map("submitted_at")
  submittedBy      String?   @map("submitted_by")
  /// 묶음 승인 — 사내 규정 시행일·개정 사유
  effectiveDate    DateTime? @map("effective_date") @db.Date
  changeNote       String?   @map("change_note")
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")
  rejectedAt       DateTime? @map("rejected_at")
  rejectedBy       String?   @map("rejected_by")
  rejectReason     String?   @map("reject_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy  Policy                  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  session RegulationParseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  items   ReparseReviewItem[]

  @@index([tenantId, policyId, createdAt])
  @@index([sessionId])
  @@map("reparse_reviews")
}

/// 재파싱 검토 항목 — 재파싱 조문 하나 또는 원문에 없는 저장 조문 하나
model ReparseReviewItem {
  id              String    @id @default(uuid())
  reviewId        String    @map("review_id")
  seq             Int
  /// same(그대로) | moved(옮김) | changed(같은 자리, 본문 다름) | ambiguous(판정 보류) | new(새 조문 후보) | missing(원문에 없음)
  kind            String
  /// 대응한 기존 조문 — 판정 보류·새 조문 후보는 비어 있다
  articleId       String?   @map("article_id")
  /// 재파싱 쪽: 행 순번·트리 노드·계층·장·절·제목·본문·지문
  parsed          Json?
  /// 저장 쪽 비교 기준: 비교 버전 id·상태·본문·지문·시행/폐지일·계층·제목·작업본 — 반영·승인 때 다시 확인한다
  stored          Json?
  /// 판정 보류 후보(조문 id·표시·본문)
  candidates      Json?
  /// 판정 근거(번호·본문·띄어쓰기·상위 조·하위 조문·이웃·빈 본문·번호 다시 매김·폐지·중복)
  reasons         Json
  /// 바뀐 것(본문·띄어쓰기만·번호·장·절·제목)
  changes         Json?
  /// 결정을 미리 골라 둘 만큼 근거가 있다
  recommended     Boolean   @default(false)
  /// 결정 — accept(옮김 받아들임) | amend(개정) | new(새 조문) | hold(보류) | pick(후보 고르기) | link(기존 조문에 잇기)
  /// | keep(그대로 둠) | repeal(폐지). 비어 있으면 미결(원문에 없음은 "삭제 여부 미결"로 남을 수 있다)
  decision        String?
  /// pick·link 가 가리키는 기존 조문
  targetArticleId String?   @map("target_article_id")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  /// 반영·승인의 결과(T-110 ②) — 만든 초안·새 조문·폐지·유지 등
  outcome         Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  review        ReparseReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  version       ArticleVersion? @relation("ReparseItemVersion")
  article       Article?      @relation("ReparseItemArticle", fields: [articleId], references: [id], onDelete: SetNull)
  targetArticle Article?      @relation("ReparseItemTarget", fields: [targetArticleId], references: [id], onDelete: SetNull)

  @@unique([reviewId, seq])
  @@index([articleId])
  @@map("reparse_review_items")
}

/// T-130 규정 근거 AI 질의응답 기록 — 무엇을 묻고 AI 가 무엇을 근거로 답했는지, 월 한도·비용 집계용
model AiQaLog {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  userId           String?  @map("user_id")
  question         String   @db.Text
  /// 근거가 남아 답을 내보냈는가
  answerable       Boolean
  /// 화면에 낸 답 블록(문단·목록·표). 답하지 않았으면 null
  answer           Json?
  /// 근거로 보여 준 조문 행
  citedArticleIds  String[] @map("cited_article_ids")
  /// AI 에 본문을 준 조문 행 수
  contextRowCount  Int      @default(0) @map("context_row_count")
  /// AI 를 불렀는가 — 월 한도는 이것만 센다(근거 후보가 하나도 없으면 부르지 않는다)
  aiCalled         Boolean  @map("ai_called")
  model            String?
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("ai_qa_logs")
}
